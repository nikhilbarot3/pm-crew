# ── watsonx.ai ──────────────────────────────────────────────────────────────
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr

# ── LLM provider toggle ──────────────────────────────────────────────────────
# Set to "google" to use Vertex AI Gemini as the LLM (fallback / demo backup)
# Leave blank or set to "ibm" to use watsonx.ai (default)
LLM_PROVIDER=ibm

# ── Google Vertex AI (fallback LLM — only needed if LLM_PROVIDER=google) ────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── IBM Cloudant ─────────────────────────────────────────────────────────────
CLOUDANT_URL=https://your-instance.cloudantnosqldb.appdomain.cloud
CLOUDANT_API_KEY=your-cloudant-api-key

# ── IBM Cloud Object Storage ─────────────────────────────────────────────────
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_API_KEY=your-cos-api-key
COS_INSTANCE_CRN=crn:v1:bluemix:public:cloud-object-storage:global:...
COS_BUCKET=pm-crew-data

# ── Service URLs (for local dev, override per deploy target) ─────────────────
ML_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_URL=http://localhost:8002
DATA_RAG_SERVICE_URL=http://localhost:8003

# ── Misc ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
